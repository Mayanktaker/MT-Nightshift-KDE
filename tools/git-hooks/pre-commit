#
# Pre-commit gate for the palette, the package metadata and the Aurorae
# decoration. Installed with:
#   git config core.hooksPath tools/git-hooks
#
# The palette/metadata audit runs on every commit: it is stdlib-only and takes
# ~0.1s, and the drift it catches (a colours-only commit that updated the scheme
# but not its two mirrors, a semantic colour dimmed below the floor) is invisible
# in a review. The decoration raster checks only run when the artwork or its
# tooling is staged, because they compile a probe.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! audit_output=$(./tools/theme-audit/check-theme.py 2>&1); then
    printf '%s\n' "$audit_output"
    echo "pre-commit: palette/metadata audit failed; see validation.md" >&2
    exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACM -- \
    'themes/aurorae/**' 'tools/decoration-probe/**' || true)
if [ -z "$staged" ]; then
    exit 0
fi

echo "pre-commit: decoration artwork changed, running checks"

if ! drift=$(python3 tools/decoration-probe/build-decoration.py --check 2>&1); then
    printf '%s\n' "$drift"
    echo "  decoration.svg is out of date with build-decoration.py; regenerate it" >&2
    exit 1
fi
echo "  generator drift: $drift"

if ! buttons=$(python3 tools/decoration-probe/check-buttons.py 2>&1); then
    printf '%s\n' "$buttons"
    echo "  button tones or geometry do not match the variant palettes" >&2
    exit 1
fi
echo "  buttons: 5 variants x 8 states match their palettes"

# --quiet prints one measured line per variant and every failure, so the hook
# summary names the geometry it verified instead of dumping the transcript.
for svg in themes/aurorae/MT*/decoration.svg; do
    variant=$(basename "$(dirname "$svg")")
    if ! out=$(./tools/decoration-probe/check-decoration.py --quiet "$svg" 2>&1); then
        printf '%s\n' "$out"
        echo "  decoration checks failed for $svg; fix the artwork before committing" >&2
        exit 1
    fi
    printf '  %-14s %s\n' "$variant" "${out#decoration.svg ok  }"
done

echo "pre-commit: decoration checks passed (shadow ramp, 1px band width, reinforcement, tangent stub)"
