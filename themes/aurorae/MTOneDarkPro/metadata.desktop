#
# Aurorae window decoration for the MT One Dark Pro desktop.
# Plain directory theme: Aurorae discovers this file via
# XDG_DATA_HOME or XDG_DATA_DIRS, under aurorae/themes/MTOneDarkPro/.

[Desktop Entry]
Type=Service
Name=MT One Dark Pro
Comment=One Dark Pro window decoration with sculpted corners, a 1px frame edge and restrained blue accents.
X-KDE-PluginInfo-Author=Mayanktaker Computers & Web Development
X-KDE-PluginInfo-Name=MTOneDarkPro
X-KDE-PluginInfo-Version=1.6.1
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=LGPL
X-KDE-PluginInfo-EnabledByDefault=true
