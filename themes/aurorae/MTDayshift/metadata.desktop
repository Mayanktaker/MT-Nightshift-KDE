#
# Aurorae window decoration for the MT Dayshift desktop (light variant).
# Plain directory theme: Aurorae discovers this file via
# XDG_DATA_HOME or XDG_DATA_DIRS, under aurorae/themes/MTDayshift/.

[Desktop Entry]
Type=Service
Name=MT Dayshift
Comment=Sculpted carbon-white window decoration with 15px corners, a 1px frame edge and the shared Nightshift blue accents.
X-KDE-PluginInfo-Author=Mayanktaker Computers & Web Development
X-KDE-PluginInfo-Name=MTDayshift
X-KDE-PluginInfo-Version=1.7.0
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=LGPL
X-KDE-PluginInfo-EnabledByDefault=true
