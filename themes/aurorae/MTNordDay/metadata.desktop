#
# Aurorae window decoration for the MT Nord Day desktop (light variant).
# Plain directory theme: Aurorae discovers this file via
# XDG_DATA_HOME or XDG_DATA_DIRS, under aurorae/themes/MTNordDay/.

[Desktop Entry]
Type=Service
Name=MT Nord Day
Comment=Sculpted Snow Storm window decoration with 15px corners, a 1px frame edge and the Nord frost accents.
X-KDE-PluginInfo-Author=Mayanktaker Computers & Web Development
X-KDE-PluginInfo-Name=MTNordDay
X-KDE-PluginInfo-Version=1.7.0
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=LGPL
X-KDE-PluginInfo-EnabledByDefault=true
