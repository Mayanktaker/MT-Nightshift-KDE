#
# Aurorae window decoration for the MT Nord Night desktop.
# Plain directory theme: Aurorae discovers this file via
# XDG_DATA_HOME or XDG_DATA_DIRS, under aurorae/themes/MTNordNight/.

[Desktop Entry]
Type=Service
Name=MT Nord Night
Comment=Sculpted Polar Night window decoration with 15px corners, a 1px frame edge and the Nord frost accents.
X-KDE-PluginInfo-Author=Mayanktaker Computers & Web Development
X-KDE-PluginInfo-Name=MTNordNight
X-KDE-PluginInfo-Version=1.6.1
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=LGPL
X-KDE-PluginInfo-EnabledByDefault=true
