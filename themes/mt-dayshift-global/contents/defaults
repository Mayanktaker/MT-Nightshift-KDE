# MT Dayshift global theme defaults for Plasma 6.8 — the light counterpart of
# MT Nightshift. Layouts, icons, cursor, wallpaper and splash are intentionally
# omitted so applying this theme keeps the user's current layout, Tela-circle
# icons, cursor, wallpaper and splash.

[kdeglobals][KDE]
# The widget style plugin is palette-driven: the same MTNightshift style draws
# pill surfaces from whichever scheme is active, so Dayshift reuses it.
widgetStyle=MTNightshift
# Seam contrast follows the same dimmed-border pass as Nightshift (0.05).
frameContrast=0.05

[kdeglobals][General]
ColorScheme=MT-Dayshift

[plasmarc][Theme]
name=mt-dayshift

# Aurorae decoration is provided by the MT Dayshift decoration package.
[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__MTDayshift
